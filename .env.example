APP_NAME=Lawyer AI
APP_VERSION=0.1.0
DEBUG=true

API_V1_PREFIX=/api/v1

# Async postgres URL — uses asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:merasql@postgres:5432/lawyer_ai

# Security — CHANGE before deploying
SECRET_KEY=super-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis (for Celery)
REDIS_URL=redis://:meraredis@redis:6379/0
